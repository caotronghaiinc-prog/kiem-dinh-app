# local env files -- .env*.local đã đủ cho cách dùng thực tế của repo này
# (chỉ có .env.local), nhưng thêm các biến thể chuẩn của Next.js phòng khi
# sau này có ai tạo .env hoặc .env.production trần (không có hậu tố
# .local) thì vẫn không lỡ commit (OWASP RULE-01).
.env
.env.local
.env.production
.env.production.local
.env.development.local
.env.test.local
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
