NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chỉ cần cho /api/test-login (Playwright e2e chạy local) -- tự generate 1
# chuỗi ngẫu nhiên bất kỳ (vd `openssl rand -hex 32`) và đặt VÀO
# .env.local, KHÔNG đặt biến này trên Vercel hay bất kỳ môi trường
# production/preview nào. Xem src/app/api/test-login/route.ts.
E2E_TEST_LOGIN_SECRET=

# PROMPT-12: soạn tin nhắn Zalo bằng AI (src/lib/ai/draft-message.ts) --
# dùng OpenAI (ngoại lệ riêng cho tính năng này, mọi tính năng AI khác
# dùng Claude API). Lấy key tại platform.openai.com. CẦN đặt cả trên Vercel
# (Project Settings -> Environment Variables) để chạy trên production/preview.
OPENAI_API_KEY=
